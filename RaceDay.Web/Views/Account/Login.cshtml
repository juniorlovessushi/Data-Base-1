@model RaceDay.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Organiser Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow p-4">
            <div class="card-body">
                <h3 class="card-title fw-bold text-center mb-4 text-primary">Organiser Login</h3>

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="admin@raceday.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mt-2">Sign In</button>
                </form>
            </div>
        </div>
    </div>
</div>