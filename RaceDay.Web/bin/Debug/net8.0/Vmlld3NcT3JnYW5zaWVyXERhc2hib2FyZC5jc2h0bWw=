@model IEnumerable<RaceDay.Web.ViewModels.EventViewModel>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Organiser Dashboard</h2>
        <a asp-action="CreateEvent" class="btn btn-primary px-3 shadow-sm">+ Create New Event</a>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var ev in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card event-card h-100 shadow-sm">
                       
                        <img src="@(string.IsNullOrEmpty(ev.BannerImageUrl) ? Url.Content("~/Images/Reverend insainty.jpg") : ev.BannerImageUrl)"
                             class="card-img-top event-banner-img"
                             alt="@ev.EventName Banner" />

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark">@ev.EventName</h5>
                            <p class="card-text text-muted mb-1">
                                <i class="bi bi-calendar-event me-1"></i> @ev.EventDate.ToShortDateString()
                            </p>
                            <p class="card-text text-muted mb-3">
                                <i class="bi bi-geo-alt me-1"></i> @ev.Location
                            </p>
                            <div class="mt-auto">
                                <a asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-outline-primary w-100">View Race</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">No events created yet. Click above to create your first race event!</p>
            </div>
        }
    </div>
</div>